{
    "name": "solvospace",
    "license": "AGPL-3.0-or-later",
    "private": true,
    "scripts": {
        "dev": "concurrently \"turbo run dev --concurrency=10\" \"wait-on http://localhost:3006 && open http://localhost:3006\"",
        "clean": "turbo run clean && rm -rf .turbo .next node_modules dist",
        "build": "turbo build --concurrency=4",
        "start": "turbo start",
        "lint": "turbo lint"
    },
    "devDependencies": {
        "concurrently": "^10.0.5",
        "wait-on": "^9.1.0",
        "turbo": "2.11.10",
        "@types/node": "24.1.0",
        "typescript": "6.0.3",
        "eslint": "9.39.1"
    },
    "packageManager": "pnpm@12.15.0",
    "engines": {
        "node": "24.22.1"
    }
}